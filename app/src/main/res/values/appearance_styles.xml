<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.UiLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#147A70</item>
        <item name="android:colorControlActivated">#147A70</item>
        <item name="android:colorControlNormal">#52676C</item>
        <item name="android:colorButtonNormal">#FFFFFF</item>
        <item name="android:textColorPrimary">#1D3439</item>
        <item name="android:textColorSecondary">#52676C</item>
        <item name="android:textColorHint">#52676C</item>
        <item name="android:colorBackground">#F4F7F8</item>
        <item name="android:windowBackground">#F4F7F8</item>
        <item name="android:windowLightStatusBar">true</item>
