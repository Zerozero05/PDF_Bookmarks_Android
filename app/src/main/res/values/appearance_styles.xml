        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#10191B</item>
        <item name="android:navigationBarColor">#10191B</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
