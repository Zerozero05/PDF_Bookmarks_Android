<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:allowBackup="false" android:largeHeap="true"
        android:icon="@drawable/ic_book" android:label="PDF目录工具" android:theme="@style/AppTheme"
        android:supportsRtl="true" android:usesCleartextTraffic="false">
        <provider android:name=".UpdateApkProvider" android:authorities="${applicationId}.updates"
            android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
